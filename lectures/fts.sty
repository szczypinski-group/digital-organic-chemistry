% FONTS (XeLaTeX)
% -----------------------

\RequirePackage{microtype}
\RequirePackage{fontspec}
\RequirePackage{unicode-math}
\setmainfont[
    Path = fonts/, 
    Extension = .ttf, 
    UprightFont = *-Regular, 
    BoldFont = *-Bold, 
    ItalicFont = *-Italic, 
    BoldItalicFont = *-BoldItalic, 
]{STIXTwoText} 
\setmathfont[ Path = fonts/, ]{STIXTwoMath-Regular.ttf}
\setsansfont{Lato}
\setmonofont[
    Path = fonts/,
    Extension = .ttf,
    UprightFont = *-Regular,
    BoldFont = *-Bold,
    Scale = MatchLowercase,
    Contextuals = Alternate,
    Renderer = Basic,
]{FiraCodeNerdFont}

